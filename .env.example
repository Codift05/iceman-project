# Salin menjadi .env lalu isi nilainya. Berkas .env tidak pernah masuk git.
#
#   cp .env.example .env
#
# Nilai di bawah adalah contoh untuk pengembangan lokal. Jangan dipakai di
# staging maupun produksi.

# --- basis data ---
POSTGRES_USER=iceman
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-anda
POSTGRES_DB=iceman
POSTGRES_PORT=5433

DATABASE_URL=postgres://iceman:ganti-dengan-kata-sandi-anda@localhost:5433/iceman?sslmode=disable

# --- server ---
HTTP_ADDR=:8088

# Kunci penandatangan token akses. Bila dikosongkan, server membangkitkan kunci
# acak saat mulai dan memberi peringatan. Token menjadi tidak berlaku setiap
# server dinyalakan ulang, sehingga hanya nyaman untuk pengembangan.
# Produksi wajib mengisinya dari pengelola secret.
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# --- pekerja latar ---
# Jumlah job yang boleh berjalan serentak pada satu proses pekerja.
WORKER_CONCURRENCY=5
